# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=PortFlow AI
APP_VERSION=2.0.0
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://portflow:portflow@db:5432/portflow

# ── Security / JWT ─────────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-64-char-random-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── Redis (token blacklist, caching) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Never use "*" — this app
# sends credentialed requests, and a wildcard origin combined with credentials
# gets reflected back to any caller (see app/config.py for why this is rejected
# at startup, not just discouraged here).
# Example: CORS_ORIGINS=https://app.portflow.ai,https://admin.portflow.ai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to use dev mode (emails printed to console logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM_EMAIL=noreply@portflow.ai

# ── Frontend URL (used in password reset links) ────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── S3 Backup Storage (optional) ──────────────────────────────────────────────
# Leave empty to store backups locally only (/tmp/portflow_backups)
S3_BACKUP_BUCKET=

# ── Log retention ──────────────────────────────────────────────────────────────
LOG_RETENTION_MONTHS=12
